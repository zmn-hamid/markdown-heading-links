{
  "name": "markdown-heading-links",
  "version": "1.0.3",
  "description": "Plugin for standard Markdown links to headings.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit -skipLibCheck && node esbuild.config.mjs production",
