    "markdown",
    "headings",
    "links"
  ],
  "author": "Hamid",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
